# Copy this file to .env (same folder as docker-compose.yml) before running docker compose.
# Make a secret with:  openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:8080
# Optional email settings. Without SMTP_HOST the reset link shows up in the server logs.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
